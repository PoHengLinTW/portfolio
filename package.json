{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:migrate:local": "wrangler d1 migrations apply portfolio --local",
		"db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.17",
		"jose": "^6.2.17",
		"marked": "^18.2.0",
		"next": "^16.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^20.19.30",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.6",
		"prettier": "^3.8.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"wrangler": "^4.162.0"
	}
}
